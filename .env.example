APP_NAME=ClaimFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost/claim-system/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL / MariaDB. On this XAMPP machine MariaDB listens on 3307 (3306 is a separate MySQL80 server).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=claim_system
DB_USERNAME=root
DB_PASSWORD=

# ---- Local OCR (no cloud / AI service is used) ----
# Full path to tesseract.exe. Use single quotes for Windows paths (backslashes).
#   Check: tesseract --version   and   tesseract --list-langs
TESSERACT_PATH='C:\Program Files\Tesseract-OCR\tesseract.exe'
# Only languages that are installed, e.g. eng, eng+msa, eng+chi_sim
TESSERACT_LANG=eng
# Page segmentation modes, all tried (best reading wins): 4 = till receipts, 6 = A4 invoices with tables.
TESSERACT_PSM=4,6
OCR_TIMEOUT=60
OCR_RETRY_PER_MINUTE=6
# Optional Poppler tools for PDF receipts. Leave empty if not installed (PDF OCR then fails gracefully,
# users can still type details manually).
PDFTOTEXT_PATH=
PDFTOPPM_PATH=
PDF_MAX_PAGES=3

# ---- Receipt uploads ----
RECEIPT_MAX_KB=10240
RECEIPT_MAX_FILES=10

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
